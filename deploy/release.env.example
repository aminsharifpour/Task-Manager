# Copy outside the repository; never commit actual secrets.
# Generate independent hexadecimal secrets (at least 32 bytes each).
POSTGRES_PASSWORD=
JWT_SECRET=
APP_IMAGE=shekof-app:0.1.0
DEPLOYMENT_MODE=self_hosted
SITE_ADDRESS=localhost
PUBLIC_SITE_URL=https://localhost:8443
HTTPS_PORT=8443
HTTP_PORT=8080
BIND_ADDRESS=127.0.0.1
CADDY_CONFIG=./deploy/Caddyfile
MARKETING_INDEX_ENABLED=false
PUBLIC_LEADS_ENABLED=false
PUBLIC_SIGNUP_ENABLED=true
JWT_EXPIRES_IN=12h
# Optional branding and contact configuration.
PRODUCT_NAME=مدیریت پروژه شکف
PRODUCT_LOGO_PATH=
PRODUCT_DESCRIPTION=
PUBLIC_CONTACT_EMAIL=
