# Development/staging foundation only. Copy to .env.local and choose private credentials.
DB_MODE=postgres
DEPLOYMENT_MODE=self_hosted
TENANT_FOUNDATION_ENABLED=true
TELEMETRY_ENABLED=false
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@127.0.0.1:5432/YOUR_DATABASE
JWT_SECRET=REPLACE_WITH_A_PRIVATE_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
PRODUCT_NAME=مدیریت پروژه شکف
SERVE_CLIENT=false
CORS_ORIGIN=http://localhost:5180
PORT=8787
FILE_STORAGE_DRIVER=local
# Optional absolute path for private file volume; default: apps/api/data/private-files
# PRIVATE_FILES_DIR=C:/taskapp-data/private-files
