{
  "name": "tasks",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:full",
    "dev:full": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "vite --config apps/web/vite.config.ts --host 0.0.0.0 --port 5180 --strictPort",
    "dev:api": "node scripts/start-api.mjs",
    "audit:heroui3": "node scripts/audit-heroui-v3-readiness.mjs",
    "verify:api": "node --check apps/api/src/index.js",
    "verify:web": "tsc -p apps/web/tsconfig.json --noEmit",
    "verify:launch": "node scripts/launch-readiness.mjs",
    "build": "tsc -p apps/web/tsconfig.json && vite build --config apps/web/vite.config.ts",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "start:api": "node scripts/start-api.mjs",
    "preview:web": "vite preview --config apps/web/vite.config.ts --host 0.0.0.0 --port 4173 --strictPort",
    "preview:web:prod": "npm run build:web && npm run preview:web",
    "prisma:generate": "prisma generate --schema apps/api/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema apps/api/prisma/schema.prisma",
    "prisma:push": "prisma db push --schema apps/api/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema apps/api/prisma/schema.prisma",
    "db:migrate-json": "node apps/api/scripts/migrate-json-to-postgres.mjs",
    "db:bootstrap-postgres": "node apps/api/scripts/bootstrap-postgres.mjs",
    "test:e2e": "node tests/e2e/main.mjs",
    "preview": "vite preview --config apps/web/vite.config.ts",
    "start": "node scripts/start-api.mjs",
    "prisma:deploy": "prisma migrate deploy --schema apps/api/prisma/schema.prisma",
    "test:foundation": "node --test tests/foundation/*.test.mjs",
    "test:postgres": "node tests/integration/tenant-postgres.mjs",
    "setup:organization": "node apps/api/scripts/setup-organization.mjs",
    "test:browser": "node tests/browser/foundation.mjs",
    "review:foundation": "node scripts/review-foundation.mjs",
    "test:modules": "node tests/integration/modules-postgres.mjs",
    "test:upgrade": "node tests/integration/legacy-upgrade.mjs",
    "test:files": "node tests/integration/files-postgres.mjs",
    "files:plan-legacy": "node apps/api/scripts/plan-legacy-files.mjs",
    "test:core": "node tests/integration/core-postgres.mjs",
    "test:accounts": "node tests/integration/accounts-postgres.mjs",
    "test:realtime": "node tests/integration/realtime-postgres.mjs",
    "files:apply-legacy": "node apps/api/scripts/apply-legacy-files.mjs",
    "test:legacy-blobs": "node tests/integration/legacy-blobs-postgres.mjs",
    "files:reconcile": "node apps/api/scripts/reconcile-files.mjs",
    "test:s3": "node tests/integration/s3-storage.mjs",
    "test:browser-onboarding": "node tests/browser/onboarding.mjs",
    "test:load": "node tests/load/core-load.mjs",
    "test:marketing": "node tests/integration/marketing-postgres.mjs",
    "test:operations": "node tests/integration/operations-postgres.mjs",
    "test:browser-marketing": "node tests/browser/marketing.mjs",
    "test:release": "node tests/integration/release-compose.mjs",
    "backup:compose": "node scripts/compose-backup.mjs",
    "restore:compose": "node scripts/compose-restore.mjs",
    "release:build": "node scripts/build-release.mjs",
    "upgrade:compose": "node scripts/compose-upgrade.mjs",
    "files:snapshot": "node apps/api/scripts/object-snapshot.mjs"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/jalaali-js": "^1.2.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.2.1",
    "lighthouse": "13.5.0",
    "playwright": "^1.62.1",
    "postcss": "^8.5.6",
    "prisma": "^6.7.0",
    "sharp": "0.35.5",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1150.0",
    "@heroui/react": "^3.0.2",
    "@prisma/client": "^6.7.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "1.8.2",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "jalaali-js": "^1.2.8",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.563.0",
    "react": "^19.2.5",
    "react-day-picker": "^9.13.2",
    "react-dom": "^19.2.5",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7"
  }
}
